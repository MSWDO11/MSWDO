      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "civilStatus": { "type": "string" },
        "sector": { "type": "string" },
